{
  "name": "amireslamdoust.github.io",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Personal portfolio of Amir Eslamdoust — design-system-first hiring site on GitHub Pages",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.9.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint src scripts tests --max-warnings=0",
    "lint:content": "node scripts/lint-content.mjs",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "precommit": "lint-staged && pnpm lint:content && pnpm typecheck && pnpm test",
    "ci": "pnpm lint && pnpm lint:content && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.8",
    "@astrojs/mdx": "^8.1.4",
    "@astrojs/react": "^7.1.7",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.10",
    "cmdk": "^1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
