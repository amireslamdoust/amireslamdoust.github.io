---
---

<figure class="diagram-frame">
  <svg viewBox="0 0 760 360" role="img" aria-labelledby="platform-diagram-title platform-diagram-desc">
    <title id="platform-diagram-title">Shared frontend platform architecture</title>
    <desc id="platform-diagram-desc">
      Six frontend applications consume shared packages — component library, analytics library,
      OpenAPI TypeScript client, and e2e suites — talking to REST services through OpenAPI contracts.
      Promotions uses Module Federation.
    </desc>
    <rect x="0" y="0" width="760" height="360" fill="var(--color-surface)" rx="16" />
    <text x="28" y="42" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="12">
      EDGE APPLICATIONS
    </text>
    {
      [
        { x: 28, lines: ['Shop'] },
        { x: 148, lines: ['Backoffice'] },
        { x: 268, lines: ['Merchant', 'Center'] },
        { x: 388, lines: ['Promotions'] },
        { x: 508, lines: ['Marketing', 'site'] },
        { x: 628, lines: ['Mobile', 'app'] },
      ].map((box) => (
        <g>
          <rect
            x={box.x}
            y="58"
            width="104"
            height="54"
            rx="10"
            fill="var(--color-bg-elevated)"
            stroke="var(--color-border)"
          />
          {box.lines.map((line, index) => (
            <text
              x={box.x + 52}
              y={box.lines.length === 1 ? 90 : 82 + index * 14}
              text-anchor="middle"
              fill="var(--color-ink)"
              font-family="var(--font-body)"
              font-size="12"
            >
              {line}
            </text>
          ))}
        </g>
      ))
    }
    <text x="28" y="160" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="12">
      SHARED PLATFORM PACKAGES
    </text>
    {
      [
        { x: 28, w: 170, label: 'Multi-theme\ncomponent library' },
        { x: 214, w: 170, label: 'Analytics &\ntracking JS lib' },
        { x: 400, w: 170, label: 'OpenAPI\nTS client' },
        { x: 586, w: 146, label: 'E2E\nsuites' },
      ].map((box) => (
        <g>
          <rect
            x={box.x}
            y="176"
            width={box.w}
            height="64"
            rx="10"
            fill="var(--color-accent-soft)"
            stroke="var(--color-accent)"
          />
          {box.label.split('\n').map((line, index) => (
            <text
              x={box.x + box.w / 2}
              y={204 + index * 16}
              text-anchor="middle"
              fill="var(--color-ink)"
              font-family="var(--font-body)"
              font-size="12"
            >
              {line}
            </text>
          ))}
        </g>
      ))
    }
    <text x="28" y="284" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="12">
      CONTRACT
    </text>
    <rect
      x="28"
      y="300"
      width="704"
      height="40"
      rx="10"
      fill="var(--color-bg-elevated)"
      stroke="var(--color-border)"
    />
    <text
      x="380"
      y="325"
      text-anchor="middle"
      fill="var(--color-ink)"
      font-family="var(--font-body)"
      font-size="13"
    >
      REST + OpenAPI contracts (moved back from GraphQL middleware)
    </text>
  </svg>
  <figcaption class="diagram-caption">
    Shared packages sit between product frontends and REST services. Promotions ships as a micro frontend via Module Federation.
  </figcaption>
</figure>
