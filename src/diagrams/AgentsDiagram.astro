---
---

<figure class="diagram-frame">
  <svg viewBox="0 0 760 400" role="img" aria-labelledby="agents-diagram-title agents-diagram-desc">
    <title id="agents-diagram-title">AI-agent developer tooling architecture</title>
    <desc id="agents-diagram-desc">
      Engineers use four coding-agent engines with eight policy-enforced roles. Skills and AGENTS.md
      feed two MCP servers. A human review gate sits in front of install; CI and the installer both check it.
    </desc>
    <rect width="760" height="400" fill="var(--color-surface)" rx="16" />
    <text x="28" y="36" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="12">
      ENGINES
    </text>
    {
      ['Claude Code', 'Codex', 'Copilot', 'Gemini'].map((label, index) => (
        <g>
          <rect
            x={28 + index * 180}
            y="48"
            width="160"
            height="42"
            rx="10"
            fill="var(--color-bg-elevated)"
            stroke="var(--color-border)"
          />
          <text
            x={108 + index * 180}
            y="74"
            text-anchor="middle"
            fill="var(--color-ink)"
            font-family="var(--font-body)"
            font-size="13"
          >
            {label}
          </text>
        </g>
      ))
    }
    <text x="28" y="130" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="12">
      ROLES · SKILLS · CONTRACT
    </text>
    <rect x="28" y="142" width="340" height="70" rx="10" fill="var(--color-accent-soft)" stroke="var(--color-accent)" />
    <text x="198" y="172" text-anchor="middle" fill="var(--color-ink)" font-family="var(--font-body)" font-size="13">
      8 agent roles (policy R/W)
    </text>
    <text x="198" y="192" text-anchor="middle" fill="var(--color-ink)" font-family="var(--font-body)" font-size="13">
      Tiered skills + AGENTS.md
    </text>
    <rect x="392" y="142" width="340" height="70" rx="10" fill="var(--color-bg-elevated)" stroke="var(--color-border)" />
    <text x="562" y="172" text-anchor="middle" fill="var(--color-ink)" font-family="var(--font-body)" font-size="13">
      MCP A: shared memory
    </text>
    <text x="562" y="192" text-anchor="middle" fill="var(--color-ink)" font-family="var(--font-body)" font-size="13">
      MCP B: read-only integrations
    </text>
    <text x="28" y="250" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="12">
      SAFETY GATE
    </text>
    <rect x="28" y="262" width="704" height="54" rx="10" fill="var(--color-warm)" opacity="0.35" stroke="var(--color-accent)" />
    <text x="380" y="295" text-anchor="middle" fill="var(--color-ink)" font-family="var(--font-body)" font-size="14">
      Reviewed decision required before install — enforced by CI and installer
    </text>
    <text x="28" y="350" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="12">
      DISTRIBUTION
    </text>
    <rect x="28" y="362" width="704" height="24" rx="8" fill="var(--color-bg-elevated)" stroke="var(--color-border)" />
    <text x="380" y="379" text-anchor="middle" fill="var(--color-ink)" font-family="var(--font-body)" font-size="12">
      Plugin marketplace · auto-update · SHA-versioned releases
    </text>
  </svg>
  <figcaption class="diagram-caption">
    Contracts and a human review gate sit above any single agent vendor. Integrations stay read-only with locked-down credential handling.
  </figcaption>
</figure>
